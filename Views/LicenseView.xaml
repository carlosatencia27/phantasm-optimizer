<local:BasePage x:Class="PC_Optimizer.Views.LicenseView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:PC_Optimizer.Views"
                xmlns:vms="clr-namespace:PC_Optimizer.ViewModels"
                mc:Ignorable="d"
                d:DesignHeight="450" d:DesignWidth="800"
                d:DataContext="{d:DesignInstance Type=vms:LicenseViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="{StaticResource MarginPageTop}">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- Estado actual -->
            <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource TextSection}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ID de equipo -->
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Tu ID de equipo" Style="{StaticResource TextSection}" />
                    <TextBlock Text="{Binding MachineId}" Style="{StaticResource TextSection}"
                               FontFamily="Consolas" Margin="0,8,0,8" />
                    <Button Content="Copiar ID" Command="{Binding CopyIdCommand}"
                            Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Static vms:LicenseViewModel.PrivacyText}" Style="{StaticResource TextCaption}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Activación -->
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="2. Pega o carga tu licencia" Style="{StaticResource TextSection}" />
                    <TextBox Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" Margin="0,8,0,8"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Texto de la licencia" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Activar" Command="{Binding ActivateCommand}"
                                Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" />
                        <Button Content="Cargar archivo .lic…" Command="{Binding LoadFileCommand}"
                                Style="{StaticResource ButtonGhost}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Feedback}" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap"
                       Text="Sin licencia válida puedes ver el estado de tu PC, usar el modo simulación y deshacer cambios anteriores. Deshacer cambios no depende de la licencia." />
        </StackPanel>
    </ScrollViewer>
</local:BasePage>
