<local:BasePage x:Class="PC_Optimizer.Views.BackupHistoryView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:PC_Optimizer.Views"
                xmlns:vms="clr-namespace:PC_Optimizer.ViewModels"
                mc:Ignorable="d"
                d:DesignHeight="450" d:DesignWidth="800"
                d:DataContext="{d:DesignInstance Type=vms:BackupHistoryViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="{StaticResource MarginPageTop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource SimulationBanner}" Margin="0,0,0,16"
                    Visibility="{Binding DryRunMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource FontIcons}"
                               FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushWarning}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Solo simulado: «Revertir» no cambiará nada mientras el modo simulación esté encendido."
                               Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- La barra de mensajes desaparece por completo cuando no hay texto -->
            <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▸" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}">
            <StackPanel>
                <!-- Historial -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⏱" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Historial de cambios aplicados y revertidos"
                                       Style="{StaticResource TextCardTitle}" />
                        </StackPanel>

                        <Grid>
                            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding ChangeLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,14"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="{StaticResource RadiusControl}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource ColorSurfaceHover}" Opacity="0" />
                                            </Border.Background>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Duration="{StaticResource DurationFast}"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                                                             To="0.55" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Duration="{StaticResource DurationFast}"
                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                                                             To="0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding SettingName}" Style="{StaticResource TextBody}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextCaption}"
                                                               Margin="0,3,0,6" />
                                                    <WrapPanel>
                                                        <Border Style="{StaticResource BadgeNoReversible}"
                                                                Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="✖" FontSize="{StaticResource FontSizeChip}"
                                                                           Margin="0,0,5,0"
                                                                           Foreground="{StaticResource BrushRiskAdvancedText}" />
                                                                <TextBlock Text="No reversible"
                                                                           Style="{StaticResource TextChip}"
                                                                           Foreground="{StaticResource BrushRiskAdvancedText}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Style="{StaticResource ChipBase}"
                                                                Visibility="{Binding DryRun, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="◐" FontSize="{StaticResource FontSizeChip}"
                                                                           Margin="0,0,5,0"
                                                                           Foreground="{StaticResource BrushWarning}" />
                                                                <TextBlock Text="Solo simulado"
                                                                           Style="{StaticResource TextChip}"
                                                                           Foreground="{StaticResource BrushWarning}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="↺ Revertir"
                                                        Command="{Binding DataContext.RevertEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding SettingKey}"
                                                        Style="{StaticResource ButtonSmall}"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding RevertAvailable}"
                                                        Visibility="{Binding IsPermanent, Converter={StaticResource InverseBoolToCollapsedConverter}}"
                                                        ToolTip="Devuelve este ajuste a su valor original guardado. No actúa sobre la limpieza de archivos." />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Estado vacío -->
                            <local:StatePanel Kind="Empty" Title="Todavía no hay cambios registrados"
        Message="Aquí aparecerá cada ajuste que apliques o reviertas, con su valor anterior y el nuevo. Mientras esté vacío, esta app no ha registrado ningún cambio en este equipo."
        Visibility="{Binding ElementName=HistoryList, Path=HasItems, Converter={StaticResource InverseBoolToCollapsedConverter}}" />
                        </Grid>

                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,12,0,0"
                                   Text="Cada ajuste guarda una copia del valor original para poder revertirlo individualmente o todos juntos. Las entradas marcadas «No reversible» no se pueden deshacer." />
                    </StackPanel>
                </Border>

                <!-- Respaldos: punto de restauración -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🛡" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Respaldos: punto de restauración" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}"
                                   Text="Un punto de restauración guarda el estado de Windows antes de aplicar cambios. Protege la configuración del sistema, pero no recupera archivos borrados. Esta app no lista los puntos que ya existan en el equipo." />
                        <Button Content="🛡 Crear punto de restauración" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Style="{StaticResource ButtonGhost}"
                                Command="{Binding DataContext.CreateRestorePointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Se crea un punto de restauración de Windows. Requiere permisos de administrador y puede tardar." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:BasePage>
