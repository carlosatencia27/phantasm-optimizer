<UserControl x:Class="PC_Optimizer.Views.TelemetryTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PC_Optimizer.Views">
    <!-- Una métrica real: anillo, cifra grande y mini-gráfica de las últimas muestras.
         Si no hay dato, muestra «No disponible» (nunca un valor inventado). -->
    <Border Style="{StaticResource CardPanel}" Margin="0" Padding="14,12">
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:TelemetryTile}}"
                       Style="{StaticResource TextEyebrow}" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="64" Height="64">
                    <local:RingGauge x:Name="Ring" Track="{StaticResource BrushBorder}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ValueBlock" Style="{StaticResource TextMetricValue}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailBlock" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <local:Sparkline x:Name="Spark" Height="26" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
