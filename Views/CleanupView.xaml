<local:BasePage x:Class="PC_Optimizer.Views.CleanupView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:PC_Optimizer.Views"
                xmlns:vms="clr-namespace:PC_Optimizer.ViewModels"
                xmlns:converters="clr-namespace:PC_Optimizer.Converters"
                mc:Ignorable="d"
                d:DesignHeight="450" d:DesignWidth="800"
                d:DataContext="{d:DesignInstance Type=vms:CleanupViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="{StaticResource MarginPageTop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mensaje de estado: icono + texto, distinguible sin depender del color -->
        <Border Grid.Row="0" Style="{StaticResource SimulationBanner}" Margin="0,0,0,16"
                Visibility="{Binding DryRunMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource FontIcons}"
                           FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushWarning}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Solo simulado: la limpieza no borrará ningún archivo mientras el modo simulación esté encendido."
                           Style="{StaticResource TextCaption}"
                           Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}">
            <StackPanel>
                <!-- La barra de mensajes desaparece por completo cuando no hay texto -->
                <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▸" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Opciones de limpieza: solo se muestran las que tienen algo que limpiar -->
                <Grid>
                    <ItemsControl x:Name="CleanupItems" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextCardTitle}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding RealisticEffect}" Style="{StaticResource TextCaption}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                                            <WrapPanel Style="{StaticResource ChipRow}" Margin="0,8,0,0">
                                                <local:RiskBadge Level="{Binding RiskText}" />

                                                <Border Style="{StaticResource ChipGeneric}">
                                                    <TextBlock Text="{Binding VerificationChip}"
                                                               Style="{StaticResource TextChip}"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>

                                                <!-- El enlace solo se crea si hay URL comprobada -->
                                                <Border Style="{StaticResource ChipGeneric}"
                                                        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Hyperlink ToolTip="{Binding DocumentationUrl}"
                                                                   RequestNavigate="OnSourceLinkRequestNavigate">
                                                            <Hyperlink.Style>
                                                                <Style TargetType="Hyperlink" BasedOn="{StaticResource SourceLink}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSource}" Value="True">
                                                                            <Setter Property="NavigateUri" Value="{Binding DocumentationUrl}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Hyperlink.Style>
                                                            Ver fuente
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </Border>

                                                <Border Style="{StaticResource ChipGeneric}">
                                                    <TextBlock Text="{Binding PreviewChip}"
                                                               Style="{StaticResource TextChip}"
                                                               Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>

                                                <Border Style="{StaticResource BadgeNoReversible}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠" FontSize="{StaticResource FontSizeChip}"
                                                                   Margin="0,0,5,0" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource BrushRiskAdvancedText}" />
                                                        <TextBlock Text="No reversible"
                                                                   Style="{StaticResource TextChip}"
                                                                   Foreground="{StaticResource BrushRiskAdvancedText}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Motivo cuando la acción no se puede ofrecer ahora -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcons}"
                                                           FontSize="{StaticResource FontSizeIconSm}"
                                                           Foreground="{StaticResource BrushWarning}"
                                                           VerticalAlignment="Top" Margin="0,1,6,0" />
                                                <TextBlock Text="{Binding ProblemText}" Style="{StaticResource TextCaption}"
                                                           Foreground="{StaticResource BrushWarning}"
                                                           TextWrapping="Wrap" MaxWidth="620" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionLabel}"
                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Key}"
                                                    Style="{StaticResource ButtonDanger}"
                                                    Visibility="{Binding CanClean, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="{Binding CleanTooltip}" />

                                            <Button Content="Reiniciar como administrador"
                                                    Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource ButtonGhost}"
                                                    Visibility="{Binding ShowElevate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="Vuelve a abrir la app con permisos de administrador para poder limpiar esta carpeta." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado vacío -->
                    <local:StatePanel Kind="Loading" Title="Cargando…" Message="Calculando la vista previa. No se ha borrado nada."
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:StatePanel Kind="Error" Title="No se pudo calcular la vista previa" Message="{Binding ErrorText}"
                                      ActionText="Reintentar" ActionCommand="{Binding RetryCommand}"
                                      Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <local:StatePanel Kind="Empty" Title="No hay nada que limpiar"
        Message="Las carpetas revisadas no tienen archivos que se puedan borrar. Si esperabas verlos, cierra las aplicaciones que los estén usando y vuelve a abrir esta sección."
        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <!-- Nota de honestidad -->
                <Border Style="{StaticResource StatusBanner}" Margin="0,4,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcons}" FontSize="{StaticResource FontSizeIcon}"
                                   Foreground="{StaticResource BrushWarning}"
                                   VerticalAlignment="Top" Margin="0,1,8,0" />
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="Todas las limpiezas son definitivas: los archivos se borran permanentemente y no se pueden recuperar. Solo se toca la carpeta de cada acción (las temporales del usuario, los informes de errores de tu usuario y la caché de Optimización de entrega) y se omiten los archivos en uso. Si una carpeta no se puede leer, no se muestra ninguna cifra inventada." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:BasePage>
