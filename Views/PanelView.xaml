<local:BasePage x:Class="PC_Optimizer.Views.PanelView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:PC_Optimizer.Views"
                xmlns:vms="clr-namespace:PC_Optimizer.ViewModels"
                xmlns:conv="clr-namespace:PC_Optimizer.Converters"
                mc:Ignorable="d"
                d:DesignHeight="700" d:DesignWidth="900"
                d:DataContext="{d:DesignInstance Type=vms:PanelViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="{StaticResource MarginPageTop}">
        <Grid.RowDefinitions>
            <!-- Fila 1: Resumen del análisis + Monitor -->
            <RowDefinition Height="Auto" />
            <!-- Fila 2: 4 tarjetas de telemetría en vivo -->
            <RowDefinition Height="Auto" />
            <!-- Fila 3: Ajustes del sistema | Limpieza y Seguridad -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             FILA 1: Resumen del análisis (datos reales) + Monitor
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Resumen del análisis" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoadingSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextCaption}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceElevated}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Archivos temporales encontrados"
                                           Style="{StaticResource TextCaption}" />
                                <TextBlock Text="{Binding Metrics.TempFilesDisplay, TargetNullValue='No disponible'}"
                                           Style="{StaticResource TextSubtitle}"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceElevated}"
                                CornerRadius="{StaticResource RadiusControl}" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Categorías de ajustes" Style="{StaticResource TextCaption}" />
                                <TextBlock Text="{Binding Groups.Count, StringFormat={}{0} categorías}"
                                           Style="{StaticResource TextSubtitle}"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Equipo" Style="{StaticResource TextCaption}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource TextBody}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="▷  Analizar de nuevo"
                            Command="{Binding AnalyzeCommand}"
                            Style="{StaticResource ButtonGhost}"
                            HorizontalAlignment="Left"
                            ToolTip="Vuelve a leer el estado actual de todos los ajustes del sistema." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🖥" FontSize="{StaticResource FontSizeIcon}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Monitor" Style="{StaticResource TextCardTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Metrics.MonitorRefreshDisplay, TargetNullValue='No disponible'}"
                               Style="{StaticResource TextHero}"
                               Foreground="{StaticResource BrushAccent}" />
                    <TextBlock Text="{Binding Metrics.MonitorDescription, TargetNullValue='No disponible'}"
                               Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             FILA 2: Telemetría real (CPU, RAM, Disco, Red)
             Sin mini gráfica: la app no guarda historial de muestras,
             así que no se dibuja nada que no exista.
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:TelemetryTile Grid.Column="0" Title="CPU" Margin="0,0,10,0"
                                         Percent="{Binding Metrics.CpuUsagePercent}" IsAvailable="{Binding CpuAvailable}"
                                         Detail="{Binding Metrics.CpuName}" History="{Binding CpuHistory}"
                                         Accent="{StaticResource BrushAccent}" />
            <local:TelemetryTile Grid.Column="1" Title="RAM" Margin="0,0,10,0"
                                         Percent="{Binding Metrics.RamUsagePercent}" IsAvailable="{Binding RamAvailable}"
                                         Detail="{Binding Metrics.RamDescription}" History="{Binding RamHistory}"
                                         Accent="{StaticResource BrushMagenta}" />
            <local:TelemetryTile Grid.Column="2" Title="DISCO C:" Margin="0,0,10,0"
                                         Percent="{Binding Metrics.DiskUsagePercent}" IsAvailable="{Binding DiskAvailable}"
                                         Detail="{Binding Metrics.DiskDescription}" History="{Binding DiskHistory}"
                                         Accent="{StaticResource BrushWarning}" />
            <local:TelemetryTile Grid.Column="3" Title="RED"
                                         Percent="{Binding Metrics.NetworkUsagePercent}" IsAvailable="{Binding NetAvailable}"
                                         ValueText="{Binding Metrics.NetworkSpeed}"
                                         Detail="{Binding Metrics.NetworkDescription}" History="{Binding NetHistory}"
                                         Accent="{StaticResource BrushBlue}" />
        </Grid>

        <!-- ══════════════════════════════════════════════════
             FILA 3: Ajustes del sistema | Limpieza y Seguridad
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Ajustes del sistema" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Text="{Binding StatusMessage}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}">
                        <Grid>
                            <ItemsControl x:Name="SettingsList" ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- Título del grupo -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="//" FontSize="{StaticResource FontSizeEyebrow}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushAccent}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource TextSection}" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Fila de ajuste: hover sutil de 150 ms -->
                                                        <Border Padding="12,14"
                                                                BorderBrush="{StaticResource BrushBorder}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="{StaticResource RadiusControl}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{StaticResource ColorSurfaceHover}" Opacity="0" />
                                                            </Border.Background>
                                                            <Border.Triggers>
<EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></EventTrigger>
<EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></EventTrigger>
<EventTrigger RoutedEvent="GotKeyboardFocus"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></EventTrigger>
<EventTrigger RoutedEvent="LostKeyboardFocus"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Duration="{StaticResource DurationFast}"
                                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                                                                             To="0.55" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Duration="{StaticResource DurationFast}"
                                                                                             Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                                                                             To="0" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Style="{StaticResource TextBody}"
                                                                               FontWeight="SemiBold"
                                                                               ToolTip="{Binding TechnicalTooltip}" />
                                                                    <TextBlock Text="{Binding Description}"
                                                                               Style="{StaticResource TextCaption}"
                                                                               Margin="0,3,0,4" />
<TextBlock Text="{Binding JargonHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" FontStyle="Italic"
    Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"
    Visibility="{Binding JargonHint, Converter={StaticResource NullToCollapsedConverter}}" />

                                                                    <!-- Qué hace el interruptor, en una línea -->
                                                                    <TextBlock Text="{Binding SwitchActionText}"
                                                                               Style="{StaticResource TextCaption}"
                                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                                               Margin="0,0,0,6" />

                                                                    <!-- Chips: riesgo con símbolo, requisitos, verificación y efecto -->
                                                                    <WrapPanel Style="{StaticResource ChipRow}">
                                                                        <local:RiskBadge Level="{Binding RiskChip}" />

                                                                        <Border Style="{StaticResource ChipGeneric}"
                                                                                Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcons}"
                                                                                           FontSize="{StaticResource FontSizeChip}"
                                                                                           Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource BrushWarning}" />
                                                                                <TextBlock Text="Requiere reinicio"
                                                                                           Style="{StaticResource TextChip}"
                                                                                           Foreground="{StaticResource BrushWarning}" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Border Style="{StaticResource ChipGeneric}"
                                                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FontIcons}"
                                                                                           FontSize="{StaticResource FontSizeChip}"
                                                                                           Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource BrushWarning}" />
                                                                                <TextBlock Text="Requiere administrador"
                                                                                           Style="{StaticResource TextChip}"
                                                                                           Foreground="{StaticResource BrushWarning}" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Border Style="{StaticResource ChipGeneric}"
                                                                                ToolTip="{Binding VerificationTooltip}">
                                                                            <TextBlock Text="{Binding VerificationChip}"
                                                                                       Style="{StaticResource TextChip}"
                                                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                                                        </Border>

                                                                        <Border Style="{StaticResource ChipGeneric}"
                                                                                ToolTip="{Binding EffectTooltip}">
                                                                            <TextBlock Text="Efecto: puede variar"
                                                                                       Style="{StaticResource TextChip}"
                                                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                                                        </Border>

                                                                        <Border Style="{StaticResource ChipGeneric}"
                                                                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock VerticalAlignment="Center">
                                                                                <!-- El enlace solo se crea si hay URL: sin fuente, el chip queda colapsado
                                                                                     y no se genera ningún aviso de enlace con valor nulo. -->
                                                                                <Hyperlink ToolTip="{Binding DocumentationUrl}"
                                                                                           RequestNavigate="OnSourceLinkRequestNavigate">
                                                                                    <Hyperlink.Style>
                                                                                        <Style TargetType="Hyperlink" BasedOn="{StaticResource SourceLink}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding HasSource}" Value="True">
                                                                                                    <Setter Property="NavigateUri" Value="{Binding DocumentationUrl}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Hyperlink.Style>
                                                                                    Ver fuente
                                                                                </Hyperlink>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </WrapPanel>

                                                                    <!-- Estado real leído del sistema -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                                ToolTip="{Binding TechnicalTooltip}">
                                                                        <TextBlock Text="Estado actual de Windows: " Style="{StaticResource TextCaption}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                                        <TextBlock Text="{Binding CurrentValueText}"
                                                                                   Style="{StaticResource TextCaption}"
                                                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                                                    </StackPanel>
                                                                    <!-- Windows ya estaba en este estado sin intervención de la app -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                                Visibility="{Binding IsAppliedWithoutBackup, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                ToolTip="{Binding AppliedWithoutBackupTooltip}">
                                                                        <TextBlock Text="{Binding AppliedWithoutBackupText}"
                                                                                   Style="{StaticResource TextCaption}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                                    </StackPanel>
                                                                    <!-- Cuándo se nota el cambio en Windows -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                                ToolTip="{Binding EffectTimingTooltip}">
                                                                        <TextBlock Text="{Binding EffectTimingText}"
                                                                                   Style="{StaticResource TextCaption}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                                    </StackPanel>
                                                                    <!-- Si el efecto se puede medir en Antes y después -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding MeasurableText}"
                                                                                   Style="{StaticResource TextCaption}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center">
                                                                    <!-- Solo lectura: chip, sin interruptor -->
                                                                    <Border Style="{StaticResource ChipGeneric}"
                                                                            HorizontalAlignment="Right"
                                                                            Visibility="{Binding IsReadOnlySetting, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            ToolTip="{Binding SwitchActionText}">
                                                                        <TextBlock Text="Solo lectura"
                                                                                   Style="{StaticResource TextChip}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                                    </Border>

                                                                    <Border Style="{StaticResource ChipGeneric}"
                                                                            HorizontalAlignment="Right"
                                                                            Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            ToolTip="{Binding UnavailableReason}">
                                                                        <TextBlock Text="{Binding UnavailableReason}"
                                                                                   Style="{StaticResource TextChip}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                                    </Border>

                                                                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                                                                  HorizontalAlignment="Right"
                                                                                  IsEnabled="{Binding IsToggleEnabled}"
                                                                                  IsChecked="{Binding IsAppliedInSystem, Mode=OneWay}"
                                                                                  Command="{Binding ToggleCommand}"
                                                                                  Visibility="{Binding IsToggleVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                  ToolTip="{Binding SwitchActionText}" />
                                                                    <Button Content="Revertir"
                                                                            Command="{Binding RevertCommand}"
                                                                            Style="{StaticResource ButtonSmall}"
                                                                            IsEnabled="{Binding CanRevert}"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="0,6,0,0"
                                                                            Visibility="{Binding CanRevert, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </StackPanel>
                                                            
<Border x:Name="RowGlow" Grid.ColumnSpan="99" Margin="-12,-14" IsHitTestVisible="False" Opacity="0"
        BorderBrush="{StaticResource BrushBrandGradient}" BorderThickness="1"
        CornerRadius="{StaticResource RadiusControl}" />
</Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Estado vacío: no hay ajustes que mostrar -->
                            <local:StatePanel Kind="Empty" Title="No hay ajustes que mostrar"
        Message="No se detectaron ajustes compatibles ni programas que se inicien con Windows en este equipo. Pulsa «Analizar de nuevo» para volver a leer el sistema."
        Visibility="{Binding ElementName=SettingsList, Path=HasItems, Converter={StaticResource InverseBoolToCollapsedConverter}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Columna derecha: Limpieza + Seguridad -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🗑" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Limpieza" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>

                        <TextBlock Text="Archivos temporales"
                                   Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding Metrics.TempFilesDisplay, TargetNullValue='No disponible'}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,4,0,10" />

                        <Button Content="Ir a Limpieza"
                                Command="{Binding GoToCleanupCommand}"
                                Style="{StaticResource ButtonGhost}"
                                HorizontalAlignment="Stretch"
                                ToolTip="Abre Limpieza, donde se calcula la vista previa y se pide confirmación. Borrar %TEMP% no se puede deshacer." />

                        <TextBlock Style="{StaticResource TextCaption}"
                                   Foreground="{StaticResource BrushWarning}"
                                   Margin="0,10,0,0"
                                   Text="⚠ No reversible: los archivos borrados no se pueden recuperar." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡" FontSize="{StaticResource FontSizeIcon}" Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Seguridad" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource TextCaption}">
                            <Run Text="✓ Los ajustes guardan el valor original y se pueden revertir desde el historial." />
                            <LineBreak />
                            <LineBreak />
                            <Run Text="✖ La limpieza de archivos temporales no es reversible." />
                            <LineBreak />
                            <LineBreak />
                            <Run Text="🛡 Un punto de restauración protege la configuración del sistema, " />
                            <Run Text="no recupera archivos borrados." FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</local:BasePage>
