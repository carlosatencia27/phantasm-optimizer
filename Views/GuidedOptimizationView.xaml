<local:BasePage x:Class="PC_Optimizer.Views.GuidedOptimizationView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:PC_Optimizer.Views">
    <StackPanel Margin="0,0,0,24">
        <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="El análisis es de solo lectura. Una recomendación no garantiza más FPS; el informe compara medidas del equipo con sus márgenes de ruido." Style="{StaticResource TextBody}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BootComparison}" Style="{StaticResource TextCaption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Analizar ahora" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource ButtonPrimary}" />
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" />
                </StackPanel>
                <local:ScanBar Height="4" Margin="0,10,0,0" IsRunning="{Binding IsBusy}" />
            </StackPanel>
        </Border>

        <TextBlock Text="OPORTUNIDADES" Style="{StaticResource TextGroupLabel}" Margin="4,4,0,8" />
        <ItemsControl ItemsSource="{Binding Recommendations}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top" Margin="0,3,12,0" />
                            <StackPanel Grid.Column="1">
                                <DockPanel LastChildFill="True">
                                    <local:RiskBadge DockPanel.Dock="Right" Level="{Binding Risk}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource TextBody}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Change}" Visibility="{Binding Change, Converter={StaticResource NullToCollapsedConverter}}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Benefit}" Visibility="{Binding Benefit, Converter={StaticResource NullToCollapsedConverter}}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Warning}" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsedConverter}}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" FontStyle="Italic"
    Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"
    Visibility="{Binding Hint, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock Text="{Binding Reversible, StringFormat=Reversible: {0}}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                <Button Content="Reiniciar como administrador" Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Status}" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="4,5,4,10" />
        <Button Content="Aplicar lo seleccionado" Command="{Binding OptimizeCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" />

        <TextBlock Text="PASOS" Style="{StaticResource TextGroupLabel}" Margin="4,22,0,8" />
        <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardPanel}" Padding="14" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource TextBody}"/><TextBlock Text="{Binding Message}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="INFORME DE RESULTADOS" Style="{StaticResource TextGroupLabel}" Margin="4,20,0,8" />
        <TextBlock Text="{Binding MarginsDescription}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="4,0,4,8" />
        <Border Style="{StaticResource CardPanel}" Padding="14,4,14,4" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding ReportRows}" ItemTemplate="{StaticResource MetricComparisonRowTemplate}" />
        </Border>
        <Button Content="Revertir lo reversible" Command="{Binding RevertCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource ButtonGhost}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
    </StackPanel>
</local:BasePage>
