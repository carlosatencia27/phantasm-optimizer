<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:PC_Optimizer.Views">

  <!-- ══════════════════════════════════════════════════════════════════════════
       DICCIONARIO ÚNICO DE DISEÑO (Etapa 6A)
       Valores tomados de la maqueta "referencia-diseno-lovable" (OptiCore):
       tema oscuro casi negro con un solo acento verde lima.
       La maqueta declara sus colores en oklch; aquí están convertidos a sRGB.
       Tipografía: Segoe UI (incluida en Windows). La maqueta usa Manrope y
       Space Grotesk (licencia libre OFL), pero sus archivos no se incluyen
       porque el proyecto funciona sin internet y no se descargan recursos.
       ══════════════════════════════════════════════════════════════════════════ -->

  <!-- ══════════════ PALETA 60-30-10 ══════════════ -->
  <!-- 60% · fondo principal (maqueta: oklch(0.135 0.007 260) = #07080B) -->
  <Color x:Key="ColorBackground">#090B10</Color>
  <!-- 30% · superficies: tarjetas y barra lateral (oklch 0.185 0.008 260) -->
  <Color x:Key="ColorSurface">#0F131B</Color>
  <Color x:Key="ColorSurfaceElevated">#151A24</Color>
  <Color x:Key="ColorSurfaceHover">#1C2230</Color>
  <!-- 10% · acento único verde lima (oklch 0.89 0.21 125) -->
  <Color x:Key="ColorAccent">#22D3EE</Color>
  <Color x:Key="ColorAccentHover">#67E8F9</Color>
  <Color x:Key="ColorAccentPressed">#0EA5C0</Color>
  <Color x:Key="ColorAccentGlow">#0C2430</Color>
  <Color x:Key="ColorAccentOn">#04141A</Color>
  <!-- Texto (maqueta: foreground oklch 0.95 0.005 250 / muted 0.65 0.015 255) -->
  <Color x:Key="ColorTextPrimary">#E6EAF2</Color>
  <Color x:Key="ColorTextSecondary">#98A2B8</Color>
  <Color x:Key="ColorTextDisabled">#7A859C</Color>
  <Color x:Key="ColorTextAccent">#67E8F9</Color>
  <Color x:Key="ColorTextOnAccent">#04141A</Color>
  <!-- Estados (maqueta: signal 205, warning 80, destructive 22) -->
  <Color x:Key="ColorMagenta">#F472D0</Color>
  <Color x:Key="ColorBlue">#7C9CFF</Color>
  <Color x:Key="ColorSuccess">#4ADE80</Color>
  <Color x:Key="ColorWarning">#F5B942</Color>
  <Color x:Key="ColorDanger">#FF7070</Color>
  <Color x:Key="ColorInfo">#22D3EE</Color>
  <!-- Bordes (maqueta: border oklch 0.3 0.009 260) -->
  <Color x:Key="ColorBorder">#232A38</Color>
  <Color x:Key="ColorBorderFocus">#67E8F9</Color>
  <Color x:Key="ColorBorderActive">#22D3EE</Color>
  <!-- Chips de riesgo: pares texto/fondo verificados con contraste AA -->
  <Color x:Key="ColorRiskSafe">#0B2A33</Color>
  <Color x:Key="ColorRiskSafeText">#22D3EE</Color>
  <Color x:Key="ColorRiskModerate">#2A2110</Color>
  <Color x:Key="ColorRiskModerateText">#F5B942</Color>
  <Color x:Key="ColorRiskAdvanced">#2C1416</Color>
  <Color x:Key="ColorRiskAdvancedText">#FF7070</Color>
  <!-- Navegación -->
  <Color x:Key="ColorTabActive">#22D3EE</Color>
  <Color x:Key="ColorTabIndicator">#22D3EE</Color>
  <Color x:Key="ColorNavActiveBg">#0C2430</Color>
  <Color x:Key="ColorNavActiveBorder">#1B6F80</Color>

  <!-- ══════════════ PINCELES ══════════════ -->
  <SolidColorBrush x:Key="BrushBackground"      Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="BrushSurface"         Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />
  <SolidColorBrush x:Key="BrushSurfaceHover"    Color="{StaticResource ColorSurfaceHover}" />
  <SolidColorBrush x:Key="BrushAccent"          Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="BrushAccentHover"     Color="{StaticResource ColorAccentHover}" />
  <SolidColorBrush x:Key="BrushAccentPressed"   Color="{StaticResource ColorAccentPressed}" />
  <SolidColorBrush x:Key="BrushAccentGlow"      Color="{StaticResource ColorAccentGlow}" />
  <SolidColorBrush x:Key="BrushTextPrimary"     Color="{StaticResource ColorTextPrimary}" />
  <SolidColorBrush x:Key="BrushTextSecondary"   Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="BrushTextDisabled"    Color="{StaticResource ColorTextDisabled}" />
  <SolidColorBrush x:Key="BrushTextAccent"      Color="{StaticResource ColorTextAccent}" />
  <SolidColorBrush x:Key="BrushTextOnAccent"    Color="{StaticResource ColorTextOnAccent}" />
  <SolidColorBrush x:Key="BrushNavActiveBg"     Color="{StaticResource ColorNavActiveBg}" />
  <SolidColorBrush x:Key="BrushNavActiveBorder" Color="{StaticResource ColorNavActiveBorder}" />
  <SolidColorBrush x:Key="BrushSuccess"         Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="BrushWarning"         Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="BrushDanger"          Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="BrushInfo"            Color="{StaticResource ColorInfo}" />
  <SolidColorBrush x:Key="BrushBorder"          Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="BrushBorderFocus"     Color="{StaticResource ColorBorderFocus}" />
  <SolidColorBrush x:Key="BrushBorderActive"    Color="{StaticResource ColorBorderActive}" />
  <SolidColorBrush x:Key="BrushRiskSafe"        Color="{StaticResource ColorRiskSafe}" />
  <SolidColorBrush x:Key="BrushRiskSafeText"    Color="{StaticResource ColorRiskSafeText}" />
  <SolidColorBrush x:Key="BrushRiskModerate"    Color="{StaticResource ColorRiskModerate}" />
  <SolidColorBrush x:Key="BrushRiskModerateText" Color="{StaticResource ColorRiskModerateText}" />
  <SolidColorBrush x:Key="BrushRiskAdvanced"    Color="{StaticResource ColorRiskAdvanced}" />
  <SolidColorBrush x:Key="BrushRiskAdvancedText" Color="{StaticResource ColorRiskAdvancedText}" />

  <!-- Superficies planas (la maqueta no usa degradados decorativos) -->
  <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#07080B" Offset="0" />
    <GradientStop Color="#111316" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrushMetricCardGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#111316" Offset="0" />
    <GradientStop Color="#111316" Offset="1" />
  </LinearGradientBrush>

  <!-- ══════════════ TIPOGRAFÍA (maqueta: px de Tailwind) ══════════════ -->
  <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
  <!-- Títulos: Segoe UI Variable Display (Windows 11) con alternativa Segoe UI Semibold (Windows 10). -->
  <FontFamily x:Key="FontDisplay">Bahnschrift, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
  <!-- Cifras de métricas: monoespaciada para que los números no «bailen» al actualizarse. -->
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
  <!-- Cifras y títulos técnicos: Bahnschrift (viene con Windows 10/11); alternativa Segoe UI. -->
  <FontFamily x:Key="FontTech">Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
  <system:Double x:Key="FontSizeEyebrow">12</system:Double>   <!-- 9px · etiqueta superior -->
  <system:Double x:Key="FontSizeChip">12</system:Double>      <!-- text-[11px] · chips -->
  <system:Double x:Key="FontSizeIconSm">12</system:Double>    <!-- iconos pequeños -->
  <system:Double x:Key="FontSizeIcon">14</system:Double>      <!-- iconos de sección y tarjeta -->
  <system:Double x:Key="FontSizeCaption">13</system:Double>   <!-- text-xs · secundario -->
  <system:Double x:Key="FontSizeBody">14</system:Double>      <!-- text-sm · normal -->
  <system:Double x:Key="FontSizeSection">13</system:Double>   <!-- section-heading h2 -->
  <system:Double x:Key="FontSizeCardTitle">14</system:Double> <!-- text-sm semibold de tarjeta -->
  <system:Double x:Key="FontSizeSubtitle">16</system:Double>  <!-- h2 de tarjeta -->
  <system:Double x:Key="FontSizeTitle">26</system:Double>     <!-- page-heading h1 -->
  <system:Double x:Key="FontSizeMetric">26</system:Double>    <!-- text-3xl de telemetría -->
  <system:Double x:Key="FontSizeHero">35</system:Double>      <!-- scan-value -->
  <system:Double x:Key="FontSizeNav">13</system:Double>       <!-- nav-item -->
  <system:Double x:Key="FontSizeNavIcon">14</system:Double>   <!-- icono de la barra lateral -->
  <system:Double x:Key="FontSizeBrandIcon">16</system:Double> <!-- icono de la marca -->
  <system:Double x:Key="FontSizeGroupLabel">12</system:Double><!-- sidebar-label (9px) -->

  <!-- ══════════════ ESPACIADO Y MEDIDAS ══════════════ -->
  <system:Double x:Key="SpaceXs">4</system:Double>
  <system:Double x:Key="SpaceSm">8</system:Double>
  <system:Double x:Key="SpaceMd">12</system:Double>
  <system:Double x:Key="SpaceLg">16</system:Double>
  <system:Double x:Key="SpaceXl">20</system:Double>
  <system:Double x:Key="SpaceSection">24</system:Double>
  <GridLength x:Key="SidebarWidth">232</GridLength>
  <GridLength x:Key="TopBarHeight">64</GridLength>
  <system:Double x:Key="ToggleWidth">44</system:Double>
  <system:Double x:Key="ToggleHeight">24</system:Double>
  <system:Double x:Key="MetricBarHeight">4</system:Double>

  <Thickness x:Key="MarginPage">24,14,24,0</Thickness>
  <!-- Espacio uniforme entre el subtítulo de la sección y su primer bloque -->
  <Thickness x:Key="MarginPageTop">0,20,0,0</Thickness>
  <Thickness x:Key="MarginCard">0,0,0,16</Thickness>
  <Thickness x:Key="PaddingCard">20</Thickness>
  <!-- Alto automático: el relleno define la píldora, nunca una altura fija -->
  <Thickness x:Key="PaddingChip">9,5</Thickness>
  <Thickness x:Key="MarginChipItem">0,0,6,4</Thickness>
  <Thickness x:Key="MarginChips">0,2,0,0</Thickness>
  <Thickness x:Key="PaddingSidebar">14,16,14,12</Thickness>

  <!-- Radios (maqueta: rounded-lg 8px tarjetas, 4px controles, chips de radio moderado) -->
  <CornerRadius x:Key="RadiusCard">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusChip">11</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">14</CornerRadius>
  <CornerRadius x:Key="RadiusNav">6</CornerRadius>

  <!-- Tipografía de iconos: Segoe Fluent Icons con Segoe MDL2 Assets como respaldo -->
  <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ══════════════ ANIMACIONES (100–200 ms) ══════════════ -->
  <Duration x:Key="DurationFast">0:0:0.12</Duration>
  <!-- Brillo de borde y avisos: la app pone ambos a 0 si Windows tiene las animaciones desactivadas. -->
  <Duration x:Key="DurationGlow">0:0:0.15</Duration>
  <Duration x:Key="DurationToast">0:0:0.25</Duration>
  <Duration x:Key="DurationNormal">0:0:0.18</Duration>

  <!-- ══════════════ FOCO DE TECLADO VISIBLE ══════════════ -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" StrokeThickness="2" RadiusX="6" RadiusY="6"
                     Stroke="{StaticResource BrushBorderFocus}"
                     SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════ JERARQUÍA TIPOGRÁFICA ══════════════ -->
  <Style x:Key="TextBase" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <!-- 5 · etiquetas -->
  <Style x:Key="TextEyebrow" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>

  <Style x:Key="TextGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeGroupLabel}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>

  <Style x:Key="TextChip" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeChip}" />
    <Setter Property="FontWeight" Value="Medium" />
    <!-- Los chips son de una sola línea: el texto nunca se recorta ni se parte -->
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 4 · texto secundario -->
  <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>

  <!-- 3 · texto normal -->
  <Style x:Key="TextBody" TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

  <!-- 1 · título de sección -->
  <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontFamily" Value="{StaticResource FontTech}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 2 · subtítulo -->
  <Style x:Key="TextSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
  </Style>

  <Style x:Key="TextCardTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
  </Style>

  <!-- Título de grupo dentro de una lista de ajustes -->
  <Style x:Key="TextSection" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
  </Style>

  <Style x:Key="TextHero" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource FontTech}" />
  </Style>

  <Style x:Key="TextMetricValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontTech}" />
  </Style>

  <Style x:Key="TextAccent" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="Foreground" Value="{StaticResource BrushTextAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ========== TARJETAS ========== -->
  <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}" />
  <SolidColorBrush x:Key="BrushMagenta" Color="{StaticResource ColorMagenta}" />
  <!-- Degradado de marca cian a magenta (brillo de borde y líneas divisorias) -->
  <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#22D3EE" Offset="0" />
    <GradientStop Color="#F472D0" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrushBrandFade" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#0022D3EE" Offset="0" />
    <GradientStop Color="#22D3EE" Offset="0.35" />
    <GradientStop Color="#F472D0" Offset="0.75" />
    <GradientStop Color="#00F472D0" Offset="1" />
  </LinearGradientBrush>
  <!-- Rejilla tenue de fondo: mosaico estático (se congela al arrancar). -->
  <DrawingBrush x:Key="BrushGrid" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"
                Viewbox="0,0,40,40" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Geometry="M0,0 H40 M0,0 V40">
        <GeometryDrawing.Pen>
          <Pen Brush="#141A26" Thickness="1" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <LinearGradientBrush x:Key="BrushCardBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#22D3EE" Offset="0" />
    <GradientStop Color="#1F3A4A" Offset="0.12" />
    <GradientStop Color="#1D2432" Offset="0.5" />
    <GradientStop Color="#181E2A" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="CardPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
    <Setter Property="BorderThickness" Value="1,2,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    <Setter Property="Margin" Value="{StaticResource MarginCard}" />
    <Setter Property="views:CardGlow.Enabled" Value="True" />
  </Style>

  <Style x:Key="CardElevated" TargetType="Border" BasedOn="{StaticResource CardPanel}">
    <Setter Property="Background" Value="{StaticResource BrushSurfaceElevated}" />
  </Style>

  <!-- Tarjeta de telemetría: valor grande + barra -->
  <Style x:Key="MetricCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderActive}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========== BARRA DE PROGRESO ========== -->
  <!-- PART_Track + PART_Indicator: WPF calcula el ancho real del relleno -->

  <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="{StaticResource MetricBarHeight}" />
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Background" Value="{StaticResource BrushSurfaceElevated}" />
    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SeparatorH" TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource BrushBorder}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
  </Style>

  <!-- ========== BOTONES ========== -->
  <Style x:Key="ButtonPrimary" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
          <Border x:Name="Root" CornerRadius="{StaticResource RadiusControl}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource ColorAccent}" />
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0" BorderBrush="{StaticResource BrushBrandGradient}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Duration="{StaticResource DurationFast}"
                                  Storyboard.TargetName="Root"
                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                  To="{StaticResource ColorAccentHover}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Duration="{StaticResource DurationFast}"
                                  Storyboard.TargetName="Root"
                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                  To="{StaticResource ColorAccent}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushSurfaceElevated}" />
              <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón secundario / fantasma (maqueta: action-secondary) -->
  <Style x:Key="ButtonGhost" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
          <Border x:Name="Root" CornerRadius="{StaticResource RadiusControl}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource ColorSurfaceElevated}" Opacity="0.35" />
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0" BorderBrush="{StaticResource BrushBrandGradient}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationGlow}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Duration="{StaticResource DurationFast}"
                                  Storyboard.TargetName="Root"
                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                  To="{StaticResource ColorSurfaceHover}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimation Duration="{StaticResource DurationFast}"
                                  Storyboard.TargetName="Root"
                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                  To="{StaticResource ColorSurfaceElevated}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushBorderFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
  </Style>

  <Style x:Key="ButtonSmall" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeChip}" />
  </Style>

  <!-- ========== INTERRUPTOR (con transición) ========== -->
  <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="{StaticResource ToggleWidth}" />
    <Setter Property="Height" Value="{StaticResource ToggleHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <Border x:Name="Track" Width="{StaticResource ToggleWidth}" Height="{StaticResource ToggleHeight}"
                    CornerRadius="12">
              <Border.Background>
                <SolidColorBrush Color="{StaticResource ColorBorder}" />
              </Border.Background>
            </Border>
            <Ellipse x:Name="Thumb" Width="18" Height="18"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
              <Ellipse.Fill>
                <SolidColorBrush Color="{StaticResource ColorTextSecondary}" />
              </Ellipse.Fill>
              <Ellipse.RenderTransform>
                <TranslateTransform X="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Duration="{StaticResource DurationFast}"
                                    Storyboard.TargetName="Track"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="{StaticResource ColorAccent}" />
                    <DoubleAnimation Duration="{StaticResource DurationFast}"
                                     Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="20" />
                    <ColorAnimation Duration="{StaticResource DurationFast}"
                                    Storyboard.TargetName="Thumb"
                                    Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                    To="{StaticResource ColorAccentOn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Duration="{StaticResource DurationFast}"
                                    Storyboard.TargetName="Track"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="{StaticResource ColorBorder}" />
                    <DoubleAnimation Duration="{StaticResource DurationFast}"
                                     Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="0" />
                    <ColorAnimation Duration="{StaticResource DurationFast}"
                                    Storyboard.TargetName="Thumb"
                                    Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                    To="{StaticResource ColorTextSecondary}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.35" />
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource BrushTextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== NAVEGACIÓN LATERAL ========== -->
  <!-- Iconos de la barra lateral: Segoe Fluent Icons con Segoe MDL2 Assets de respaldo.
       Todos los glifos usados existen en ambas fuentes (verificados), así que nunca
       aparece un cuadro vacío. El tamaño sale de los recursos del diccionario. -->
  <Style x:Key="SidebarNavIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeNavIcon}" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- El color lo hereda del elemento de navegación (secundario / acento si está activo) -->
  </Style>

  <!-- La sección activa se marca con borde de acento + barra interior (no solo color) -->
  <Style x:Key="SidebarNavItem" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeNav}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" CornerRadius="{StaticResource RadiusNav}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource ColorSurface}" />
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Marca de la sección activa (visible también sin color) -->
              <Border x:Name="ActiveBar" Grid.Column="0" Width="3" Height="18"
                      CornerRadius="2" Background="{StaticResource BrushAccent}"
                      Visibility="Collapsed" Margin="-7,0,6,0" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <TextBlock x:Name="Chevron" Grid.Column="2" Text="›" FontSize="14"
                         Foreground="{StaticResource BrushAccent}" Visibility="Collapsed"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushSurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushNavActiveBg}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushNavActiveBorder}" />
              <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushBorderFocus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Etiqueta "próximamente" para secciones aún no disponibles -->
  <Style x:Key="ComingSoonChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushSurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Padding" Value="{StaticResource PaddingChip}" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========== PESTAÑAS SUPERIORES (compatibilidad) ========== -->
  <Style x:Key="TopTab" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,12" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="GroupName" Value="MainTabs" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Root" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom"
                    Background="Transparent" CornerRadius="1,1,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Indicator" Property="Background" Value="{StaticResource BrushAccent}" />
