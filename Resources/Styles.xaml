  <Style x:Key="StyledComboBox" TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource BrushSurfaceElevated}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
  </Style>


  <!-- Fila de comparación «antes y después» (Antes y después + informe de la Optimización guiada).
       Cada fila es una tarjeta compacta: nombre y resultado arriba, tres columnas iguales (Antes,
       Después, Diferencia) debajo y la explicación al final. Todo el texto se ajusta de línea, así
       que nada se pisa con ventanas estrechas o escalas de pantalla del 125 % y 150 %. -->
  <DataTemplate x:Key="MetricComparisonRowTemplate">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" Style="{StaticResource TextBody}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBase}" Margin="0" VerticalAlignment="Top"
                MaxWidth="260" ToolTip="{Binding DeltaChip}">
          <TextBlock Text="{Binding DeltaChip}" TextWrapping="Wrap">
            <TextBlock.Style>
              <!-- Color solo cuando la medición lo respalda: verde = mejora medible, coral = peor. -->
              <Style TargetType="TextBlock" BasedOn="{StaticResource TextChip}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DeltaChip}" Value="Mejora medible">
                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DeltaChip}" Value="Peor">
                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="ANTES" Style="{StaticResource TextEyebrow}" />
            <TextBlock views:CountUp.Text="{Binding BeforeText}" Style="{StaticResource TextBody}" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}" ToolTip="{Binding BeforeText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="DESPUÉS" Style="{StaticResource TextEyebrow}" />
            <TextBlock views:CountUp.Text="{Binding AfterText}" Style="{StaticResource TextBody}" TextWrapping="Wrap"
                       FontWeight="SemiBold" ToolTip="{Binding AfterText}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="DIFERENCIA" Style="{StaticResource TextEyebrow}" />
            <TextBlock views:CountUp.Text="{Binding DeltaText}" Style="{StaticResource TextBody}" TextWrapping="Wrap"
                       ToolTip="{Binding DeltaText}" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Influences}" Style="{StaticResource TextCaption}"
                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
